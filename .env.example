# Supabase Configuration (optional — in-memory mock data is used when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini / Genkit API Key (optional)
GEMINI_API_KEY=

# WhatsApp Cloud API (Server-side only — never prefix with NEXT_PUBLIC_)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional Server-side Supabase Service Role Key for secure webhook ingestion
SUPABASE_SERVICE_ROLE_KEY=

